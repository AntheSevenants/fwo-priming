@article{segaert_unifying_2016,
  title = {Unifying Structural Priming Effects on Syntactic Choices and Timing of Sentence Generation},
  author = {Segaert, Katrien and Wheeldon, Linda and Hagoort, Peter},
  year = 2016,
  month = dec,
  journal = {Journal of Memory and Language},
  series = {New {{Approaches}} to {{Structural Priming}}},
  volume = {91},
  pages = {59--80},
  issn = {0749-596X},
  doi = {10.1016/j.jml.2016.03.011},
  urldate = {2026-01-22},
  abstract = {We investigated whether structural priming of production latencies is sensitive to the same factors known to influence persistence of structural choices: structure preference, cumulativity and verb repetition. In two experiments, we found structural persistence only for passives (inverse preference effect) while priming effects on latencies were stronger for the actives (positive preference effect). We found structural persistence for passives to be influenced by immediate primes and long lasting cumulativity (all preceding primes) (Experiment 1), and to be boosted by verb repetition (Experiment 2). In latencies we found effects for actives were sensitive to long lasting cumulativity (Experiment 1). In Experiment 2, in latencies we found priming for actives overall, while for passives the priming effects emerged as the cumulative exposure increased but only when also aided by verb repetition. These findings are consistent with the Two-stage Competition model, an integrated model of structural priming effects for sentence choice and latency.},
  keywords = {Cumulativity,Production latency,Structural priming,Structure preference,Syntactic choice,Verb repetition},
  file = {C\:\\Users\\u0128513\\Zotero\\storage\\4W2KDVC6\\Segaert et al. - 2016 - Unifying structural priming effects on syntactic choices and timing of sentence generation.pdf;C\:\\Users\\u0128513\\Zotero\\storage\\KHGHQ7FS\\segaert2016.pdf;C\:\\Users\\u0128513\\Zotero\\storage\\GULW4C6S\\S0749596X16300067.html}
}

