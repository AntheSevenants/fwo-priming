\coordinate (start_point) at ([yshift=2mm]output_bar_fill_1.north west);
\coordinate (end_point)   at ([yshift=2mm]output_bar_fill_extra.north east);
  
\draw (start_point) -- (end_point);
\draw ([yshift=2mm, xshift=0.067mm]output_bar_fill_1.north west) -- ++(0, -1mm);
\draw ([yshift=2mm, xshift=-0.067mm]output_bar_fill_extra.north east) -- ++(0, -1mm);
\node[above=0.35mm] at ($(start_point)!0.5!(end_point)$) {A};

\end{tikzpicture}
